# Only what the image needs goes in the build context.
# Local model caches and indexes are excluded on purpose: the image builds its own.
.git
.github
.venv
.cache
indexes
**/__pycache__
.pytest_cache
.mypy_cache
.ruff_cache
.hypothesis
.coverage
htmlcov
tests
docs
eval
*.egg-info
data/*
!data/snapshot
